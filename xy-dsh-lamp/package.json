{
  "name": "xy-dsh-lamp",
  "version": "0.2.0",
  "description": "DSH 终端灯板：每个 Agent 一盏灯，完成后收成一条消息，可置顶常驻",
  "type": "module",
  "main": "index.mjs",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "notify"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh": "0.1.5-rc.1 || 0.1.5-rc.2 || 0.1.6-alpha.1 || 0.1.6-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.5-rc.1": "compatible",
        "0.1.5-rc.2": "compatible",
        "0.1.6-alpha.1": "unknown",
        "0.1.6-alpha.2": "compatible"
      }
    }
  },
  "exports": {
    ".": {
      "default": "./index.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "overlay.html",
    "hud.swift",
    "cordis.patch.yml",
    "README.md"
  ]
}
